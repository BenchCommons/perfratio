# Homebrew formula template for perfratio. Not a live formula.
# Copy to <tap>/Formula/perfratio.rb after replacing every @PLACEHOLDER@ (see
# render.sh). SHA256 values come from the SHA256SUMS asset of the release.
class Perfratio < Formula
  desc "Multi-dimensional command-line benchmarking tool"
  homepage "https://github.com/UnitedOpen-Source/perfratio"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/UnitedOpen-Source/perfratio/releases/download/v@VERSION@/perfratio-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/UnitedOpen-Source/perfratio/releases/download/v@VERSION@/perfratio-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/UnitedOpen-Source/perfratio/releases/download/v@VERSION@/perfratio-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/UnitedOpen-Source/perfratio/releases/download/v@VERSION@/perfratio-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "perfratio"
    man1.install "perfratio.1"
    bash_completion.install "autocomplete/perfratio.bash" => "perfratio"
    fish_completion.install "autocomplete/perfratio.fish"
    zsh_completion.install "autocomplete/_perfratio"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/perfratio --version")
  end
end
